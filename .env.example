# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_REPOSITORY_QUEUE=repository_queue
RABBITMQ_REVIEW_QUEUE=review_queue
RABBITMQ_DEAD_LETTER_QUEUE=review_dlq

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=code_review
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Storage & Upload Limits
STORAGE_PATH=./storage
MAX_ZIP_SIZE_MB=25
MAX_FILES_COUNT=500
MAX_SOURCE_FILE_SIZE_KB=500

# LLM Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
